  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #050b14;
}
QTabWidget::pane {
    border: 1px solid #0b2236;
    top: -1px;
    background-color: #050b14;
}
QTabBar::tab {
    background-color: #0b1728;
    color: #9ab8d3;
    border: 1px solid #12314d;
    border-bottom-color: #0b2236;
    padding: 6px 14px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #0f2238;
    color: #e1f1ff;
    border-color: #1b4a72;
}
QTabBar::tab:hover:!selected {
    background-color: #112840;
    color: #cce6ff;
}
QWidget#steering_tab {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #050c17, stop:0.55 #071428, stop:1 #040912);
}
QWidget#steering_tab QLabel {
    color: #afc1d4;
    font-family: Bahnschrift;
    font-size: 10pt;
}
QWidget#steering_tab QFrame#steering_hero_card {
    border: 1px solid #10314b;
    border-radius: 12px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #10263f, stop:1 #0a1728);
}
QWidget#steering_tab QLabel#steering_hero_title {
    color: #63e6ff;
    font-size: 14pt;
    font-weight: 700;
    letter-spacing: 1px;
}
QWidget#steering_tab QLabel#steering_hero_subtitle {
    color: #8fb1cf;
}
QWidget#steering_tab QFrame#scope_card,
QWidget#steering_tab QFrame#pid_card,
QWidget#steering_tab QFrame#setpoint_card,
QWidget#steering_tab QFrame#runtime_card {
    border: 1px solid #0f2b44;
    border-radius: 11px;
    background-color: #081427;
}
QWidget#steering_tab QLabel#scope_title,
QWidget#steering_tab QLabel#pid_title,
QWidget#steering_tab QLabel#setpoint_title,
QWidget#steering_tab QLabel#runtime_title,
QWidget#steering_tab QLabel#telemetry_raw_title {
    color: #57dbff;
    font-size: 11pt;
    font-weight: 700;
    letter-spacing: 1px;
}
QWidget#steering_tab QLabel#scope_hint,
QWidget#steering_tab QLabel#runtime_hint,
QWidget#steering_tab QLabel#setpoint_hint {
    color: #7d97af;
}
QWidget#steering_tab QLabel#scope_live_badge {
    color: #7fffcf;
    border: 1px solid #20543f;
    border-radius: 7px;
    background-color: #0a3025;
    padding: 2px 8px;
    font-weight: 700;
}
QWidget#steering_tab QLabel#steering_conn_led {
    background-color: #090909;
    border: 1px solid #2a3644;
    border-radius: 12px;
}
QWidget#steering_tab QFrame#scope_host {
    border: 1px solid #1a3a55;
    border-radius: 8px;
    background-color: #040b16;
}
QWidget#steering_tab QPlainTextEdit#telemetry_raw_view {
    border: 1px solid #1e425f;
    border-radius: 8px;
    background-color: #030913;
    color: #9fe7c0;
    selection-background-color: #184e73;
    font-family: Consolas;
    font-size: 10pt;
}
QWidget#steering_tab QPushButton {
    border: 1px solid #20506f;
    border-radius: 7px;
    background-color: #0d2136;
    color: #d2e6fb;
    min-height: 28px;
    padding: 2px 10px;
}
QWidget#steering_tab QPushButton:hover {
    border-color: #2f88be;
    background-color: #12304b;
}
QWidget#steering_tab QPushButton:pressed {
    background-color: #153a5d;
}
QWidget#steering_tab QPushButton:disabled {
    color: #5f7285;
    border-color: #213246;
    background-color: #0a1624;
}
QWidget#steering_tab QPushButton#setpoint_send_button,
QWidget#steering_tab QPushButton#pid_apply_button,
QWidget#steering_tab QPushButton#motor_enable_button,
QWidget#steering_tab QPushButton#telemetry_send_button {
    border-color: #2b8fbe;
    color: #73ebff;
    background-color: #10344f;
}
QWidget#steering_tab QPushButton#motor_stop_button {
    border-color: #a65262;
    color: #ffc0cb;
    background-color: #311723;
}
QWidget#steering_tab QDoubleSpinBox,
QWidget#steering_tab QComboBox,
QWidget#steering_tab QLineEdit {
    border: 1px solid #1f4f74;
    border-radius: 7px;
    background-color: #061021;
    color: #b9d6ef;
    min-height: 26px;
    padding: 2px 8px;
    font-family: Consolas;
}
QWidget#steering_tab QDoubleSpinBox:focus,
QWidget#steering_tab QComboBox:focus,
QWidget#steering_tab QLineEdit:focus {
    border-color: #46d4ff;
}
QWidget#steering_tab QDial#angle_knob {
    background-color: #07182d;
    border: 1px solid #1a4366;
    border-radius: 68px;
}
QWidget#steering_tab QLabel#knob_value_lab,
QWidget#steering_tab QLabel#rt_conn_value,
QWidget#steering_tab QLabel#rt_set_value,
QWidget#steering_tab QLabel#rt_fb_value,
QWidget#steering_tab QLabel#rt_err_value,
QWidget#steering_tab QLabel#rt_pwm_value,
QWidget#steering_tab QLabel#rt_rpm_value,
QWidget#steering_tab QLabel#rt_vbus_value {
    color: #7af0ff;
    font-weight: 700;
}</string>
